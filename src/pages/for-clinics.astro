---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.mjs';
const mail = site.contactEmail;
---
<Base title="For clinics" description={`Correct your clinic’s details or feature your listing on ${site.name}.`}>
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / For clinics</p>
    <h1>For clinics</h1>
    <div class="prose">
      <p>Your listing is built from your public register record. You don’t need to sign up to appear, and you can’t pay to change a rating.</p>
      <h2>Correct your details</h2>
      <p>If your treatments, phone number or website are wrong, send us the correct details and a link that confirms them. We update listings within a week.</p>
      <h2>Feature your clinic</h2>
      <p>A featured listing puts your clinic at the top of its area and treatment pages, adds your website and photos, and sends enquiries from people asking about a consultation straight to you. Featured listings are always labelled, and only clinics with a current registration can be featured.</p>
    </div>
    <p style="margin-top:1.5rem">
      {mail ? <a class="button" href={`mailto:${mail}?subject=${encodeURIComponent('Clinic listing')}`}>Email us about your listing</a> : <span class="muted">Contact details for clinics are coming soon.</span>}
    </p>
  </div>
</Base>
